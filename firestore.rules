rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Budgets (existing) ───────────────────────────────────────────────
    match /budgets/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ─── Zikafon (existing) ──────────────────────────────────────────────
    match /zikafon_users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /zikafon_likedTracks/{trackId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /zikafon_moodSessions/{sessionId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ─── AGBAZA ──────────────────────────────────────────────────────────

    // Bibliothèque d'exercices — lecture publique, exercices custom par le propriétaire
    match /agbaza_exercises/{doc} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.isCustom == true
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.isCustom == true
        && resource.data.createdBy == request.auth.uid;
    }

    // Profil utilisateur
    match /agbaza_users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Programmes
    match /agbaza_programs/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Séances
    match /agbaza_sessions/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Templates globaux — lecture publique (authentifié), écriture admin uniquement
    match /agbaza_templates/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Poids corporel
    match /agbaza_bodyweight/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

  }
}
